{
  "name": "@error-bar/mcp",
  "version": "0.5.0",
  "description": "errorbar MCP server \u2014 every platform API (evals, criteria, gates, logs, datasets, aliases, audit, proving) as tools for Claude, Cursor, and any MCP client.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnia-v/errorbar-mcp.git"
  },
  "type": "module",
  "bin": {
    "errorbar-mcp": "dist/cli.js",
    "omnia-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "homepage": "https://docs.errorbar.ai",
  "bugs": {
    "url": "https://github.com/omnia-v/errorbar-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm-evaluation",
    "llm-as-a-judge",
    "evals",
    "errorbar",
    "claude",
    "cursor"
  ]
}
